{
  "expo": {
    "name": "Rayons",
    "slug": "rayons-app",
    "scheme": "rayons",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rayon.app",
      "associatedDomains": [
        "applinks:rayons.net",
        "applinks:www.rayons.net"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "Rayons utilise l'appareil photo pour scanner des codes ou ajouter des photos.",
        "NSPhotoLibraryUsageDescription": "Rayons accède à vos photos pour vous permettre d'envoyer des justificatifs ou photos de profil.",
        "NSLocationWhenInUseUsageDescription": "Rayons utilise votre position pour vous localiser lors de vos commandes et livraisons."
      }
    },
    "android": {
      "package": "com.rayon.app",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#0F1D27",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "rayons.net",
              "pathPrefix": "/"
            },
            {
              "scheme": "https",
              "host": "www.rayons.net",
              "pathPrefix": "/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0F1D27"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1ea43c35-47a0-466a-b18d-e766b7151a75"
      }
    }
  }
}
