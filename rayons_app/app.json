{
  "expo": {
    "name": "Rayons",
    "slug": "rayons-app",
    "scheme": "rayons",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/ios-icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.rayon.app",
      "buildNumber": "3",
      "config": {
        "usesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:rayons.net",
        "applinks:www.rayons.net"
      ],
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1"]
          }
        ]
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "fr",
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Rayons utilise l'appareil photo pour scanner des codes ou photographier vos produits et justificatifs.",
        "NSPhotoLibraryUsageDescription": "Rayons accède à vos photos pour vous permettre d'ajouter des photos de profil, produits ou justificatifs.",
        "NSPhotoLibraryAddUsageDescription": "Rayons enregistre vos factures, contrats de bail et quittances directement sur votre iPhone.",
        "NSLocationWhenInUseUsageDescription": "Rayons utilise votre position pour faciliter la livraison de vos commandes et la recherche de biens à proximité.",
        "LSApplicationQueriesSchemes": [
          "whatsapp",
          "tel",
          "mailto",
          "sms",
          "maps"
        ]
      }
    },
    "android": {
      "package": "com.rayon.app",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#0F1D27",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "rayons.net",
              "pathPrefix": "/"
            },
            {
              "scheme": "https",
              "host": "www.rayons.net",
              "pathPrefix": "/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0F1D27"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1ea43c35-47a0-466a-b18d-e766b7151a75"
      }
    }
  }
}
