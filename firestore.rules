rules_version = '2';

service cloud.firestore {
  // Helper to check role
  function isSuperAdmin() {
    return request.auth != null && (
      request.auth.token.email == 'danielkiboko218@gmail.com' ||
      request.auth.token.email == 'danielKIBOKO218@gmail.com' ||
      request.auth.token.email == 'admin@rayons.net' ||
      request.auth.token.role == 'superAdmin' ||
      request.auth.token.role == 'SUPER_ADMIN' ||
      request.auth.token.role == 'SUPERADMIN' ||
      (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
       (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SUPER_ADMIN' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superAdmin'))
    );
  }

  function isAdmin() {
    return isSuperAdmin() || (
      request.auth != null && (
        request.auth.token.role in ['admin', 'ADMIN', 'SUB_ADMIN', 'sub_admin', 'ADMIN_FINANCE', 'ADMIN_DB', 'ADMIN_TECH', 'ADMIN_OPS'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'ADMIN', 'SUB_ADMIN', 'sub_admin', 'ADMIN_FINANCE', 'ADMIN_DB', 'ADMIN_TECH', 'ADMIN_OPS', 'SUPER_ADMIN']))
      )
    );
  }

  function isSupplier() {
    return request.auth != null && (
      request.auth.token.role in ['supplier', 'SUPPLIER', 'SUPPLIER_IMMO', 'SUPPLIER_SAVEURS'] ||
      (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
       get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['supplier', 'SUPPLIER', 'SUPPLIER_IMMO', 'SUPPLIER_SAVEURS'])
    );
  }

  function isSubSupplier() {
    return request.auth != null && (
      request.auth.token.role in ['SUB_SUPPLIER', 'sub_supplier'] ||
      (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
       get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['SUB_SUPPLIER', 'sub_supplier'])
    );
  }

  function ownsSupplierData(supplierId) {
    return (isSupplier() && request.auth.uid == supplierId) ||
           (isSubSupplier() && request.auth.token.parentSupplierId == supplierId);
  }

  function isDriver() {
    return request.auth != null && (
      request.auth.token.role in ['driver', 'DRIVER'] ||
      (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
       get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['driver', 'DRIVER'])
    );
  }

  match /databases/{database}/documents {
    // Suppliers can manage their own supplier document
    match /suppliers/{supplierId} {
      allow read, write: if isSuperAdmin() || isAdmin() || (
        ownsSupplierData(supplierId)
      );
    }

    // Drivers collection – top‑level with supplierId field
    match /drivers/{driverId} {
      // Creation allowed for a supplier creating its own driver
      allow create: if ownsSupplierData(request.resource.data.supplierId);
      // Supplier can read/write its drivers, admin/superadmin can manage all, driver can manage own
      allow read, update, delete: if (
        isSuperAdmin() || isAdmin() || (
          ownsSupplierData(resource.data.supplierId)
        ) || (
          isDriver() && request.auth.uid == driverId
        )
      );
    }

    // Orders collection – each order contains supplierId and optional driverId
    match /orders/{orderId} {
      // Suppliers and admins can create orders for their supplier
      allow create: if isSuperAdmin() || isAdmin() || (
        ownsSupplierData(request.resource.data.supplierId)
      );

      // Read/write for the supplier that owns the order
      allow read, update, delete: if (
        isSuperAdmin() || isAdmin() || (
          ownsSupplierData(resource.data.supplierId)
        ) || (
          resource.data.keys().hasAll(['supplierIds']) && (
            (isSupplier() && request.auth.uid in resource.data.supplierIds) || 
            (isSubSupplier() && request.auth.token.parentSupplierId in resource.data.supplierIds)
          )
        )
      );

      // Drivers can read orders waiting for driver pickup, or orders assigned to them
      allow read: if isDriver() && (
        resource.data.status in ['CONFIRMED_AWAITING_DRIVER', 'pending_driver'] || 
        resource.data.driverId == request.auth.uid
      );
      // Drivers can accept an order (setting their own driverId) or update order status
      allow update: if isDriver() && (
        (request.resource.data.driverId == request.auth.uid && resource.data.status in ['CONFIRMED_AWAITING_DRIVER', 'pending_driver']) ||
        (resource.data.driverId == request.auth.uid && request.resource.data.driverId == request.auth.uid)
      );
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read, write: if isSuperAdmin() || isAdmin();
      allow read, update: if ownsSupplierData(resource.data.parentSupplierId);
    }

    // Chats collection
    match /chats/{chatId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null && (
        resource.data.clientId == request.auth.uid || 
        resource.data.supplierId == request.auth.uid ||
        ownsSupplierData(resource.data.supplierId) ||
        isSuperAdmin() || isAdmin()
      );

      match /messages/{messageId} {
        allow read: if request.auth != null && (
          !exists(/databases/$(database)/documents/chats/$(chatId)) ||
          get(/databases/$(database)/documents/chats/$(chatId)).data.clientId == request.auth.uid ||
          get(/databases/$(database)/documents/chats/$(chatId)).data.supplierId == request.auth.uid ||
          ownsSupplierData(get(/databases/$(database)/documents/chats/$(chatId)).data.supplierId) ||
          isSuperAdmin() || isAdmin()
        );
        allow create, write: if request.auth != null && (
          !exists(/databases/$(database)/documents/chats/$(chatId)) ||
          get(/databases/$(database)/documents/chats/$(chatId)).data.clientId == request.auth.uid ||
          get(/databases/$(database)/documents/chats/$(chatId)).data.supplierId == request.auth.uid ||
          ownsSupplierData(get(/databases/$(database)/documents/chats/$(chatId)).data.supplierId) ||
          isSuperAdmin() || isAdmin()
        );
      }
    }

    // Add additional collections (products, etc.) with similar scoping if needed.
    match /products/{productId} {
      allow read: if true;
      allow create: if ownsSupplierData(request.resource.data.supplierId);
      allow update, delete: if ownsSupplierData(resource.data.supplierId);
      allow update, delete: if isSuperAdmin() || isAdmin();

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow update, delete: if isSuperAdmin() || isAdmin();
      }
    }

    match /invoices/{invoiceId} {
      allow create: if ownsSupplierData(request.resource.data.supplierId);
      allow read, update, delete: if ownsSupplierData(resource.data.supplierId);
      allow read, update, delete: if isSuperAdmin() || isAdmin();
    }

    match /properties/{propertyId} {
      allow read: if true; // Public can see properties
      allow create: if ownsSupplierData(request.resource.data.supplierId);
      allow update, delete: if ownsSupplierData(resource.data.supplierId);
      allow update, delete: if isSuperAdmin() || isAdmin();

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow update, delete: if isSuperAdmin() || isAdmin();
      }
    }

    match /tenants/{tenantId} {
      allow create: if ownsSupplierData(request.resource.data.supplierId);
      allow read, update, delete: if ownsSupplierData(resource.data.supplierId);
      allow read, update, delete: if isSuperAdmin() || isAdmin();
    }

    match /payments/{paymentId} {
      allow create: if ownsSupplierData(request.resource.data.supplierId);
      allow read, update, delete: if ownsSupplierData(resource.data.supplierId);
      allow read, update, delete: if isSuperAdmin() || isAdmin();
    }

    match /visits/{visitId} {
      allow create: if true; // Public can request a visit
      allow read, update, delete: if ownsSupplierData(resource.data.supplierId);
      allow read, update, delete: if isSuperAdmin() || isAdmin();
    }

    match /error_logs/{logId} {
      allow create: if true; // Anyone can generate an error log
      allow read, update, delete: if isSuperAdmin() || isAdmin();
    }

    match /accounting_ledger/{entryId} {
      allow read, write: if isSuperAdmin() || isAdmin();
    }

    match /hotel_bookings/{bookingId} {
      allow create: if true;
      allow read, update, delete: if ownsSupplierData(resource.data.supplierId) || 
                                     isSuperAdmin() || 
                                     isAdmin() || 
                                     (request.auth != null && resource.data.clientId == request.auth.uid);
    }

    match /transactions/{transactionId} {
      allow read, write: if isSuperAdmin() || isAdmin();
    }
    match /supplier_transactions/{transactionId} {
      allow create: if ownsSupplierData(request.resource.data.supplierId);
      allow read, update, delete: if ownsSupplierData(resource.data.supplierId);
      allow read, write: if isSuperAdmin() || isAdmin();
    }

    match /notifications/{notifId} {
      allow create: if isSuperAdmin() || isAdmin();
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /inapp_notifications/{notifId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isSuperAdmin() || isAdmin() || (
        ownsSupplierData(resource.data.supplierId)
      ) || (
        request.auth != null && (resource.data.userId == request.auth.uid || resource.data.clientId == request.auth.uid)
      );
    }
  }
}
