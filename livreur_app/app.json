{
  "expo": {
    "name": "Rayon Livreur",
    "slug": "livreur_app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b061c",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rayon.livreur",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Rayon Livreur utilise votre position pendant une course pour guider la livraison et permettre au client de suivre son colis."
      }
    },
    "android": {
      "package": "com.rayon.livreur",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0b061c",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "VIBRATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Rayon Livreur utilise votre position pendant une course pour guider la livraison et permettre au client de suivre son colis."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0b061c"
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "b14927c9-d38f-4678-9b10-71007dba544c"
      }
    }
  }
}
